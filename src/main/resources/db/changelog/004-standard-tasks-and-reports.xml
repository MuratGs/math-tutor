            <column name="is_active" valueBoolean="true"/>
        </insert>

        <insert tableName="standard_math_tasks">
            <column name="topic" value="equations"/>
            <column name="grade" valueNumeric="7"/>
            <column name="difficulty" valueNumeric="3"/>
            <column name="statement" value="Реши уравнение: 3x − 5 = 16."/>
            <column name="correct_answer" value="7"/>
            <column name="hint" value="Сначала прибавь 5 к обеим частям, затем раздели на 3."/>
            <column name="is_manual" valueBoolean="true"/>
            <column name="is_ai_generated" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>

        <insert tableName="standard_math_tasks">
            <column name="topic" value="areas"/>
            <column name="grade" valueNumeric="6"/>
            <column name="difficulty" valueNumeric="2"/>
            <column name="statement" value="Найди площадь прямоугольника со сторонами 8 см и 5 см."/>
            <column name="correct_answer" value="40"/>
            <column name="hint" value="Площадь прямоугольника равна произведению его сторон."/>
            <column name="is_manual" valueBoolean="true"/>
            <column name="is_ai_generated" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>

        <insert tableName="standard_math_tasks">
            <column name="topic" value="areas"/>
            <column name="grade" valueNumeric="7"/>
            <column name="difficulty" valueNumeric="3"/>
            <column name="statement" value="Найди площадь треугольника с основанием 12 см и высотой 7 см."/>
            <column name="correct_answer" value="42"/>
            <column name="hint" value="S = (a·h)/2."/>
            <column name="is_manual" valueBoolean="true"/>
            <column name="is_ai_generated" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>

        <insert tableName="standard_math_tasks">
            <column name="topic" value="speed_time_distance"/>
            <column name="grade" valueNumeric="6"/>
            <column name="difficulty" valueNumeric="3"/>
            <column name="statement" value="Пешеход шёл со скоростью 4 км/ч в течение 3 часов. Какое расстояние он прошёл?"/>
            <column name="correct_answer" value="12"/>
            <column name="hint" value="S = v·t."/>
            <column name="is_manual" valueBoolean="true"/>
            <column name="is_ai_generated" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>

        <insert tableName="standard_math_tasks">
            <column name="topic" value="speed_time_distance"/>
            <column name="grade" valueNumeric="7"/>
            <column name="difficulty" valueNumeric="4"/>
            <column name="statement" value="Автомобиль проехал 150 км за 2,5 часа. Найди среднюю скорость автомобиля."/>
            <column name="correct_answer" value="60"/>
            <column name="hint" value="v = S / t."/>
            <column name="is_manual" valueBoolean="true"/>
            <column name="is_ai_generated" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>

    </changeSet>

</databaseChangeLog>
